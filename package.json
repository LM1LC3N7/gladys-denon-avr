{
  "name": "gladys-denon-avr",
  "version": "1.0.21",
  "private": true,
  "description": "Gladys Assistant external integration to control Denon/Marantz AV receivers over the network.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-include=index.js --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8"
  },
  "license": "Apache-2.0"
}
